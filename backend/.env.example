CWA_DB_URL=jdbc:postgresql://localhost:5432/chinesewithai
CWA_DB_USERNAME=postgres
CWA_DB_PASSWORD=root

# Agent runtime model provider
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Qwen / Alibaba Cloud Model Studio (OpenAI-compatible). Defaults to China (Beijing); use
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1 for Singapore/International keys.
# QWEN_API_KEY can also be provided as DASHSCOPE_API_KEY.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_ENABLE_THINKING=false

# Set to qwen3.6-plus to make Qwen the default lesson-generation model.
CWA_LESSON_GENERATION_DEFAULT_MODEL_KEY=deepseek-chat

# Presently unused by the current agent runtime integration, kept only if Spring AI/OpenAI wiring returns later.
SPRING_AI_OPENAI_API_KEY=change-me

# Optional overrides for JWT settings
JWT_ISSUER=chinesewithai-backend
JWT_SECRET=change-me-to-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=PT15M
